# Lapora — salin menjadi `.env` lalu isi nilainya.
# Semua variabel harus berawalan EXPO_PUBLIC_ agar terbaca di bundle klien.
# Tanpa nilai ini aplikasi tetap berjalan penuh secara offline
# (penyimpanan lokal AsyncStorage); remote hanya aktif bila keduanya terisi.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
